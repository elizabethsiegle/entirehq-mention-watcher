# Browserbase — copy from ~/Desktop/demos-2-idk/wimbledon-worldcup-scores/.env
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# X session cookies. In a logged-in x.com tab:
#   DevTools -> Application -> Cookies -> https://x.com
# Copy the values of `auth_token` and `ct0`.
X_AUTH_TOKEN=
X_CSRF_TOKEN=

# Slack incoming webhook for the channel that should receive mentions.
# Create at https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Optional
X_WATCH_POLL_MS=300000
X_OWN_HANDLE=entirehq

# The product domain. A post linking it is a mention even when it tags nobody.
X_BRAND_DOMAIN=entire.io

# Optional. Defaults to (@entirehq OR "entire.io"), built from the handle and
# the domain above. Set this only to search for something else entirely: it is
# used verbatim and ignores both.
X_SEARCH_QUERY=

# Optional. Enables LLM triage (Claude Haiku) on top of the deterministic
# score. Without it the score decides tiers alone, which is a supported mode.
ANTHROPIC_API_KEY=

# Comma-separated handles that never post to Slack at all.
X_MUTE_HANDLES=

# Comma-separated handles that always land in the routine tier, never priority.
# Teammates' replies are a receipt, not a call to action.
X_TEAM_HANDLES=
